<local:ClientPage x:Class="MimiRemote.App.Pages.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MimiRemote.App" xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="14" Padding="0,0,0,20">
        <StackPanel Spacing="8">
            <Button Content="刷新" Command="{x:Bind ViewModel.RefreshCommand}"/>
            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}"/>
            <InfoBar IsOpen="{x:Bind ViewModel.NoticeOpen, Mode=TwoWay}" Message="{x:Bind ViewModel.Notice, Mode=OneWay}" Severity="{x:Bind local:ClientPage.NoticeSeverity(ViewModel.Failed), Mode=OneWay}"/>
        </StackPanel>
        <Border Style="{StaticResource NativeCardStyle}">
            <StackPanel Spacing="14">
                <TextBlock Text="{x:Bind ViewModel.Heading, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}"/>
                <TextBlock Text="在手机上继续电脑里的项目与会话。关闭窗口后，电脑服务仍然运行。" TextWrapping="Wrap"/>
                <TextBlock Text="{x:Bind ViewModel.Detail, Mode=OneWay}" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="启动服务" Command="{x:Bind ViewModel.StartCommand}"/>
                    <Button Content="重新启动" Command="{x:Bind ViewModel.RestartCommand}"/>
                    <Button Content="停止服务" Command="{x:Bind ViewModel.StopCommand}"/>
                </StackPanel>
                <Button Content="连接手机" Command="{x:Bind ViewModel.PairCommand}"/>
            </StackPanel>
        </Border>
        </StackPanel>
    </ScrollViewer>
</local:ClientPage>
