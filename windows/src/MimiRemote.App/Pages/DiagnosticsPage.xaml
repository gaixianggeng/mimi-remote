<local:ClientPage x:Class="MimiRemote.App.Pages.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MimiRemote.App"
    xmlns:core="using:MimiRemote.Core"
    xmlns:vm="using:MimiRemote.App.ViewModels"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="14" Padding="0,0,0,24">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="刷新预检" Command="{x:Bind ViewModel.RefreshCommand}"/>
                <Button Content="运行只读诊断" Command="{x:Bind ViewModel.DoctorCommand}"/>
                <Button Content="读取最近日志" Command="{x:Bind ViewModel.LogsCommand}"/>
            </StackPanel>
            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}"/>
            <InfoBar IsOpen="{x:Bind ViewModel.NoticeOpen, Mode=TwoWay}" Message="{x:Bind ViewModel.Notice, Mode=OneWay}"
                Severity="{x:Bind local:ClientPage.NoticeSeverity(ViewModel.Failed), Mode=OneWay}"/>

            <Border Style="{StaticResource NativeCardStyle}" Visibility="{x:Bind ViewModel.HasRecoveryDiagnostic, Mode=OneWay}">
                <StackPanel Spacing="8">
                    <TextBlock Text="配置恢复位置（只读）" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                    <TextBlock Text="{x:Bind ViewModel.RecoverySummary, Mode=OneWay}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <TextBlock Text="预检状态与安全修复（仅展示通过契约校验的操作，不会轮换配对身份）" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap"/>
            <ItemsControl ItemsSource="{x:Bind ViewModel.PreflightRows, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="core:OnboardingWizardRow">
                        <Border Margin="0,0,0,8" Padding="12" CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{x:Bind Check.Title}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                    <TextBlock Text="{x:Bind StateBadge}" Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="{x:Bind Message}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="{x:Bind PrimaryLabel}" Tag="{x:Bind Check.Id}" Click="FixCheckClicked"
                                    Visibility="{x:Bind HasPrimaryAction}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <toolkit:SettingsExpander Header="只读诊断详情（doctor --json）" Description="仅用于排查查看，不执行任何写入或重置操作。"
                IsExpanded="False" Visibility="{x:Bind ViewModel.HasDoctorItems, Mode=OneWay}">
                <toolkit:SettingsExpander.Items>
                    <toolkit:SettingsCard ContentAlignment="Vertical" HorizontalContentAlignment="Stretch">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.DoctorItems, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ReadOnlyDoctorItem">
                                    <StackPanel Spacing="2" Margin="0,0,0,10">
                                        <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                        <TextBlock Text="{x:Bind StatusBadge}" Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="{x:Bind Message}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{x:Bind FixHint}" Visibility="{x:Bind HasFixHint}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </toolkit:SettingsCard>
                </toolkit:SettingsExpander.Items>
            </toolkit:SettingsExpander>

            <TextBox Header="诊断与脱敏日志输出" Text="{x:Bind ViewModel.Output, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                TextWrapping="Wrap" MinHeight="240" MaxHeight="600" FontFamily="Cascadia Mono"/>
        </StackPanel>
    </ScrollViewer>
</local:ClientPage>
