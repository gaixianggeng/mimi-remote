<local:ClientPage x:Class="MimiRemote.App.Pages.SessionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MimiRemote.App" xmlns:vm="using:MimiRemote.App.ViewModels" xmlns:controls="using:MimiRemote.App.Controls">
    <Grid RowSpacing="12">
        <Grid.Resources>
            <CollectionViewSource x:Name="GroupedSessions" Source="{x:Bind ViewModel.Groups}" IsSourceGrouped="True"/>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <AutoSuggestBox PlaceholderText="搜索会话或项目" Text="{x:Bind ViewModel.Query, Mode=TwoWay}"
                AutomationProperties.Name="搜索已加载的会话或项目" QueryIcon="Find"/>
            <Button Grid.Column="1" Content="刷新" Command="{x:Bind ViewModel.RefreshCommand}"/>
        </Grid>
        <Grid x:Name="Filters" Grid.Row="1" ColumnSpacing="12" RowSpacing="10" SizeChanged="FiltersResized">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <ComboBox x:Name="RuntimeFilter" ItemsSource="{x:Bind ViewModel.Runtimes}" DisplayMemberPath="Title"
                SelectedItem="{x:Bind ViewModel.Runtime, Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.Name="会话渠道"/>
            <ComboBox x:Name="ProjectFilter" Grid.Column="1" ItemsSource="{x:Bind ViewModel.Projects}" DisplayMemberPath="Name"
                SelectedItem="{x:Bind ViewModel.Project, Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.Name="会话所属项目"/>
        </Grid>
        <StackPanel Grid.Row="2" Spacing="8">
            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.Loading, Mode=OneWay}"/>
            <InfoBar IsOpen="{x:Bind ViewModel.NoticeOpen, Mode=TwoWay}" Message="{x:Bind ViewModel.Notice, Mode=OneWay}" Severity="{x:Bind local:ClientPage.NoticeSeverity(ViewModel.Failed), Mode=OneWay}"/>
        </StackPanel>
        <Grid Grid.Row="3">
            <ListView ItemsSource="{Binding Source={StaticResource GroupedSessions}}" SelectionMode="None"
                IsItemClickEnabled="False" HorizontalContentAlignment="Stretch" AutomationProperties.Name="最近会话">
                <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel AreStickyGroupHeadersEnabled="True"/></ItemsPanelTemplate></ListView.ItemsPanel>
                <ListView.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate><DataTemplate x:DataType="vm:SessionGroup">
                            <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="4,16,0,10"/>
                        </DataTemplate></GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListView.GroupStyle>
                <ListView.ItemTemplate><DataTemplate x:DataType="vm:SessionRow">
                    <Grid Padding="4,12" ColumnSpacing="12" AutomationProperties.Name="{x:Bind AccessibleName}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <FontIcon Glyph="{x:Bind RuntimeGlyph}" FontSize="20" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Spacing="5">
                            <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Title}"/>
                            <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="5" VerticalAlignment="Center" MaxWidth="160">
                            <controls:SessionStatusBadge Kind="{x:Bind StatusKind}" Label="{x:Bind Status}" Glyph="{x:Bind StatusGlyph}"/>
                            <TextBlock Text="{x:Bind Holder}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate></ListView.ItemTemplate>
            </ListView>
            <TextBlock Text="{x:Bind ViewModel.Empty, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center"
                TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsHitTestVisible="False"/>
        </Grid>
        <Grid Grid.Row="4">
            <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,120,0"/>
            <Button Content="加载更多" HorizontalAlignment="Right" Command="{x:Bind ViewModel.MoreCommand}"
                Visibility="{x:Bind ViewModel.HasMore, Mode=OneWay}"/>
        </Grid>
    </Grid>
</local:ClientPage>
