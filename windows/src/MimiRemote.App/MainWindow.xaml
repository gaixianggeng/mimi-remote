<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="MimiRemote.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root">
        <NavigationView x:Name="Navigation" IsSettingsVisible="False" PaneDisplayMode="Auto"
            IsBackButtonVisible="Collapsed" OpenPaneLength="210" SelectionChanged="Navigate">
            <NavigationView.PaneHeader>
                <StackPanel Margin="16,24,0,20" Spacing="4">
                    <TextBlock Text="Mimi Remote" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="把电脑装进口袋" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </NavigationView.PaneHeader>
            <NavigationView.MenuItems>
                <NavigationViewItem Content="概览" Tag="overview" Icon="Home"/>
                <NavigationViewItem Content="连接手机" Tag="pair" Icon="CellPhone"/>
                <NavigationViewItem Content="连接与中转" Tag="connection" Icon="World"/>
                <NavigationViewItem Content="诊断与日志" Tag="diagnostics" Icon="Repair"/>
            </NavigationView.MenuItems>
            <Grid Padding="28,24" RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="PageTitle" Text="概览" Style="{ThemeResource TitleTextBlockStyle}"/>
                    <Button Grid.Column="1" Content="刷新" Click="RefreshClicked" AutomationProperties.Name="刷新电脑状态"/>
                </Grid>
                <StackPanel Grid.Row="1" Spacing="8">
                    <ProgressBar x:Name="Progress" IsIndeterminate="True" Visibility="Collapsed"/>
                    <InfoBar x:Name="Notice" IsOpen="False" IsClosable="True" Severity="Error"/>
                </StackPanel>
                <ScrollViewer x:Name="PageScroll" Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="Body" Spacing="16" MaxWidth="850" HorizontalAlignment="Stretch"/>
                </ScrollViewer>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
