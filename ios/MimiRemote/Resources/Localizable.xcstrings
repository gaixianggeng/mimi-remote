      "comment": "Help text for the Tailcat connection address.",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Start the Mac-side host with the client public key below, then paste its address here." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "先用下方客户端公钥启动 Mac 端服务，再把服务端生成的地址粘贴到这里。" } }
      }
