        "zh-Hans": { "stringUnit": { "state": "translated", "value": "使用 Tailcat 实验模式" } }
      }
    },
    "ui.tailcat_experiment_summary": {
      "comment": "Explains what the Tailcat experiment changes.",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "When on, all requests use Tailcat only. Your saved Tailscale connection remains unchanged and resumes when this switch is off." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "开启后，所有请求只走 Tailcat。已保存的 Tailscale 连接不会被修改；关闭开关后恢复使用。" } }
      }
    },
    "ui.tailcat_pairing_help": {
      "comment": "Explains the Tailcat QR pairing flow.",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Generate a Tailcat QR code in Mimi on your Mac, then scan it from the normal add or repair computer entry. A successful scan enables this experiment automatically." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "先在 Mac 版 Mimi 的实验功能中生成 Tailcat 二维码，再从常规的添加或修复电脑入口扫码。配对成功后会自动开启本实验。" } }
      }
    },
    "ui.tailcat_pairing_address_missing": {
      "comment": "Tailcat QR validation error when its temporary service address is absent.",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The Tailcat pairing link is missing its temporary connection address." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "Tailcat 配对链接缺少临时连接地址。" } }
      }
    },
    "ui.tailcat_diagnostics_help": {
      "comment": "Explains privacy and retention for Tailcat path diagnostics.",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Shows direct, Peer Relay, or relay path latency plus one real HTTP health request. Only the latest 10 redacted results are kept on this device." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "显示直连、Peer Relay 或中转路径及延迟，并执行一次真实 HTTP 健康请求。本设备只保留最近 10 条脱敏结果。" } }
      }
    },
    "ui.tailcat_request_latency_value": {
