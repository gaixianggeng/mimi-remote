      "comment": "Explains how the Tailcat client public key is used.",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Allow this key on the Mac. The matching private key stays in this device's Keychain." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "Mac 端只允许这个公钥连接。对应私钥只保存在本设备的 Keychain 中。" } }
