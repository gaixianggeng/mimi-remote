{
  "name": "mimi-agy-adapter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mimi Remote 的 Antigravity CLI (agy) 通道适配器，基于标准 ACP (Agent Client Protocol) v1",
