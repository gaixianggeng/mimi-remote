MIMI_PUSH_LISTEN=127.0.0.1:8087
MIMI_PUSH_TOPIC=com.gaixianggeng.mimi
MIMI_PUSH_ENVIRONMENT=production
MIMI_PUSH_APNS_KEY_FILE=/etc/mimi-push-provider/apns.p8
MIMI_PUSH_APNS_KEY_ID=REPLACE_WITH_EXISTING_KEY_ID
MIMI_PUSH_APNS_TEAM_ID=REPLACE_WITH_EXISTING_TEAM_ID
MIMI_PUSH_TICKET_KEY_FILE=/etc/mimi-push-provider/ticket.keys
MIMI_PUSH_DB=/var/lib/mimi-push-provider/revocations.db
