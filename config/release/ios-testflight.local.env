# Mimi 项目适配；敏感签名材料只存在本机 Secrets 文件。
IOS_RELEASE_PROJECT_ID=mimi
IOS_RELEASE_ENTRYPOINT=scripts/ios_testflight_ci.sh
IOS_RELEASE_REQUIRED_BRANCH=main

# 渐进接入 asc：off 不调用；shadow 只记录差异；enforce 才把差异作为门禁。
# 本地默认保持关闭，可在仓库外 secrets.env 中覆盖为 shadow。
IOS_ASC_BUILD_NUMBER_MODE=off

IOS_BUNDLE_ID=com.gaixianggeng.mimi
IOS_WIDGET_BUNDLE_ID=com.gaixianggeng.mimi.carstatuswidget
IOS_NOTIFICATION_BUNDLE_ID=com.gaixianggeng.mimi.notificationservice
DEVELOPMENT_TEAM=9HZ89R58PZ
# MIM-78 合并前必须用“已启用 App Group”的新主 App profile 替换下面 ID/name。
IOS_PROVISIONING_PROFILE_ID=9NF53VCFV7
IOS_EXPECTED_PROVISIONING_PROFILE_NAME='Mimi App Store 202606300035'
# MIM-78 合并前在 Apple Developer 创建 Widget App Store profile 后取消注释并填写真实值。
# IOS_WIDGET_PROVISIONING_PROFILE_ID=YOUR_WIDGET_PROFILE_ID
# IOS_WIDGET_EXPECTED_PROVISIONING_PROFILE_NAME='Mimi Widget App Store YYYYMMDDHHMM'
# #418 通知服务扩展：在 Apple Developer 创建它的 App Store profile 后，取消注释并填写真实值，
# 或写进仓库外的 secrets.env。未填写时 git testflight-push --check 会明确失败。
# IOS_NOTIFICATION_PROVISIONING_PROFILE_ID=YOUR_NOTIFICATION_PROFILE_ID
# IOS_NOTIFICATION_EXPECTED_PROVISIONING_PROFILE_NAME='Mimi Notification App Store YYYYMMDDHHMM'
# 不固定 beta App 名称，始终使用 xcode-select 当前选中的、可被 ASC 接收的 Xcode。

TESTFLIGHT_BETA_GROUP_ID=26b7c973-b94f-46d5-b300-1c252fd6fdb1
TESTFLIGHT_BETA_GROUP_NAME='咪咪 Internal'
TESTFLIGHT_MIN_TESTERS=1
TESTFLIGHT_STATUS_TIMEOUT_SECONDS=1800
TESTFLIGHT_STATUS_INTERVAL_SECONDS=15
