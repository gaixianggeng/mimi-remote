[Unit]
Description=Mimi Remote agentd
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
ExecStartPre=-+/bin/sh -c 'd=/tmp/codex-daemon-%U; r=%t/mimi-remote; l="$$r/codex-daemon"; u="$$r/codex-daemon.unsafe"; umask 077; /bin/rm -f -- "$$l" "$$u" 2>/dev/null; /bin/mkdir -p -m 0700 -- "$$r" 2>/dev/null || { echo "mimi-remote: warning: could not prepare $$r; local shared Codex will be unavailable" >&2; exit 1; }; if [ -L "$$r" ] || [ ! -d "$$r" ]; then echo "mimi-remote: warning: ignoring unsafe $$r; local shared Codex will be unavailable" >&2; exit 1; fi; fail() { echo "$$1" >&2; printf "%s\n" "$$1" > "$$u" 2>/dev/null || true; exit 1; }; if [ -e "$$l" ] && [ ! -L "$$l" ]; then fail "mimi-remote: warning: ignoring unsafe staging path $$l; local shared Codex will be unavailable"; fi; if [ -x /bin/ln ]; then lnbin=/bin/ln; elif [ -x /usr/bin/ln ]; then lnbin=/usr/bin/ln; else fail "mimi-remote: warning: ln command not found; skipping $$d bind"; fi; if ! /bin/mkdir -m 0700 -- "$$d" 2>/dev/null; then if [ -L "$$d" ]; then fail "mimi-remote: warning: ignoring unsafe symlink $$d; local shared Codex will be unavailable"; fi; if [ ! -d "$$d" ]; then fail "mimi-remote: warning: $$d is not a directory or could not be created; local shared Codex will be unavailable"; fi; if [ -x /usr/bin/stat ]; then s=/usr/bin/stat; elif [ -x /bin/stat ]; then s=/bin/stat; else fail "mimi-remote: warning: stat command not found; skipping $$d bind"; fi; info=$$(LC_ALL=C "$$s" -c %%F:%%u -- "$$d") || fail "mimi-remote: warning: failed to inspect $$d; local shared Codex will be unavailable"; if [ "$$info" != "directory:%U" ]; then fail "mimi-remote: warning: ignoring unsafe $$d ($$info, expected directory:%U); local shared Codex will be unavailable"; fi; /bin/chmod 0700 "$$d" || fail "mimi-remote: warning: failed to secure $$d; local shared Codex will be unavailable"; fi; "$$lnbin" -s -- "$$d" "$$l" || fail "mimi-remote: warning: failed to stage $$l; local shared Codex will be unavailable"'
ExecStart=%h/.local/bin/agentd serve --config %h/.config/mimi-remote/config.json
Environment=PATH=%h/.local/bin:%h/.npm-global/bin:%h/.local/share/mise/shims:%h/.local/share/mise/installs/codex/latest/bin:/usr/local/bin:/usr/bin:/bin
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
BindPaths=-%t/mimi-remote/codex-daemon:/tmp/codex-daemon-%U

[Install]
WantedBy=default.target
