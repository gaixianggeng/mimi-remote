          }
        ]
      }
    },
    "diagnostic_fields": {
      "type": "object",
      "required": ["code", "step", "message", "fix"],
      "properties": {
        "step": {"$ref": "#/definitions/check_id"},
        "message": {"type": "string", "minLength": 1},
        "fix": {"$ref": "#/definitions/fix"},
        "config_path": {"type": "string", "minLength": 1},
        "recovery_path": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "fix": {
                "not": {
                  "properties": {
                    "target": {"const": "host_recovery"}
                  },
                  "required": ["target"]
                }
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": ["config_path"]
                },
                {
                  "required": ["recovery_path"]
                }
              ]
            }
          }
        }
      ]
    },
    "local_error": {
      "description": "UI-synthesized diagnostics only. Excluded from wire messages.",
      "type": "object",
      "required": ["ok", "error"],
      "properties": {
        "ok": {"const": false},
        "error": {
          "allOf": [
            {"$ref": "#/definitions/diagnostic_fields"},
            {
              "properties": {
                "code": {
                  "enum": ["command_timeout", "embedded_binary_missing"]
                }
              }
            }
          ]
        }
      }
    }
