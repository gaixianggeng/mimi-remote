{
  "schema": "mimi.onboarding.codes/v1",
  "checks": [
    {
      "id": "config_store",
      "group": "workspace",
      "platforms": ["macos", "windows", "linux"]
    },
    {
      "id": "workspace_root",
      "group": "workspace",
      "platforms": ["macos", "windows", "linux"]
    },
    {
      "id": "service_owner_conflict",
      "group": "service",
      "platforms": ["macos"]
    },
    {
      "id": "service_daemon",
      "group": "service",
      "platforms": ["macos", "windows", "linux"]
    },
    {
      "id": "assistant_codex",
      "group": "assistant",
      "platforms": ["macos", "windows", "linux"]
    },
    {
      "id": "assistant_claude",
      "group": "assistant",
      "platforms": ["macos", "windows", "linux"]
    },
    {
      "id": "assistant_agy",
      "group": "assistant",
      "platforms": ["macos", "windows", "linux"]
    },
    {
      "id": "assistant_deepseek",
      "group": "assistant",
      "platforms": ["macos", "windows", "linux"]
    },
    {
      "id": "assistant_any",
      "group": "assistant",
      "platforms": ["macos", "windows", "linux"]
    },
    {
      "id": "network_tailscale",
      "group": "network",
      "platforms": ["macos", "windows", "linux"]
    },
    {
      "id": "network_tailcat",
      "group": "network",
      "platforms": ["macos", "windows", "linux"]
    },
    {
      "id": "network_lan",
      "group": "network",
      "platforms": ["macos", "windows", "linux"]
    },
    {
      "id": "network_any",
      "group": "network",
      "platforms": ["macos", "windows", "linux"]
    },
    {
      "id": "permission_login_item",
      "group": "permission",
      "platforms": ["macos"]
    },
    {
      "id": "permission_folder_access",
      "group": "permission",
      "platforms": ["macos"]
    },
    {
      "id": "permission_local_network",
      "group": "permission",
      "platforms": ["macos", "windows"]
    },
    {
      "id": "permission_photos",
      "group": "permission",
      "platforms": ["macos"]
    },
    {
      "id": "permission_full_disk",
      "group": "permission",
      "platforms": ["macos"]
    }
  ],
  "urls": {
    "CODEX": "https://learn.chatgpt.com/docs/codex/cli",
    "CLAUDE": "https://code.claude.com/docs/en/quickstart",
    "AGY": "https://antigravity.google/",
    "HARNESS": "https://github.com/deepseek-ai/deepseek-harness",
    "TS": "https://tailscale.com/download",
    "DESKTOP": "https://github.com/gaixianggeng/mimi-remote/releases/latest",
    "GUIDE": "https://github.com/gaixianggeng/mimi-remote/blob/main/docs/quickstart.md"
  },
  "settings_targets": [
    "login_items",
    "files_and_folders",
    "local_network",
    "photos",
    "full_disk_access",
    "windows_firewall",
    "windows_network_profile",
    "assistants",
    "connections",
    "host_recovery",
    "date_time",
    "managed_connection"
  ],
  "path_targets": ["workspace_root", "codex_bin", "claude_bin", "agy_bin"],
  "run_fix": {
    "save_setup": {"requires_config": false},
    "enable_codex": {"requires_config": false, "before_save": "assistant_draft", "after_save": "runtime", "assistant": "codex"},
    "enable_claude": {"requires_config": false, "before_save": "assistant_draft", "after_save": "runtime", "assistant": "claude"},
    "enable_agy": {"requires_config": false, "before_save": "assistant_draft", "after_save": "runtime", "assistant": "agy"},
    "enable_tailscale": {"requires_config": true},
    "enable_lan": {"requires_config": true},
    "enable_tailcat": {"requires_config": true},
    "connect_deepseek": {"requires_config": true},
    "restart_service": {"requires_config": true},
    "register_service": {"requires_config": true},
    "doctor_fix": {
      "requires_config": true,
      "requires_capability": "identity_preserving_doctor_fix",
      "description": "仅在宿主已确认支持 BE-3 或更高版本的保身份修复时启用。"
    },
    "takeover_homebrew": {"requires_config": true}
  },
  "consumers_by_surface": {
    "check": ["macos", "winui", "windows_tray", "linux_tray"],
    "cli": ["macos", "winui", "windows_tray", "linux_tray"],
    "native": ["macos"],
    "http": ["ios", "macos", "winui", "windows_tray", "linux_tray"],
    "ui_local": ["macos", "winui", "ios", "windows_tray", "linux_tray"]
  },
  "cli_commands": [
    "preflight",
    "setup",
    "up",
    "start",
    "restart",
    "pair",
    "tailcat pair",
    "tailcat enable",
    "tailcat relay set",
    "network",
    "runtime",
    "workspace",
    "doctor --fix"
  ],
  "http": {
    "media_type": "application/vnd.mimi.onboarding.v1+json",
    "vary": "Accept",
    "paths": [
      "/api/pair/claim",
      "/api/pair/local",
      "/api/tailcat/managed-pairing-link",
      "/api/tailcat/managed-pairing-operations",
      "/api/tailcat/free-route"
    ],
    "workspace_confirmation_required": {"status": 409, "after": "authentication"}
  },
  "variant_matching": "Select the unique variant whose when fields all equal the observation. An omitted condition imposes no restriction. Platforms restrict the producing host and step. Consumers are listed by surface and can run on another OS. UI-local codes are never accepted on the wire.",
  "signed_out_states": {
    "setup": {"explicitly_enabled": "action_needed", "otherwise": "optional"},
    "pair": {"enabled": "action_needed", "otherwise": "optional"},
    "blocking": false
  },
  "native_overlay": {
    "platform": "macos",
    "permissions": "Only replace the matching permission row on positive native evidence.",
    "service_daemon": {
      "replaces": "service_not_running",
      "evidence": "SMAppService.agent.status.requiresApproval",
      "code": "service_requires_approval"
    },
    "after": "recompute blocking, ok and recommended_next"
  },
  "client_actions": {
    "connections": "Open the pairing step or tray pairing menu.",
    "assistants": "Open assistant settings or tray assistant controls.",
    "host_recovery": "Read-only inspection of scrubbed local recovery paths.",
    "date_time_ios": "Show system date and time instructions and retry.",
    "managed_connection": "Open subscription or desktop relay settings upon confirmed entitlement failure.",
    "host_repairs_ios": "Explain the matching desktop step, then offer rescan.",
    "unknown_step_ui_local": "service_daemon"
  },
  "localization": {
    "lookup": ["code+step", "code"],
    "title_parameter": "title"
  },
  "progress": {
    "stream": "stderr",
    "record": "check",
    "initial_state": "checking",
    "final_report_stream": "stdout",
    "per_candidate_timeout_seconds": 4,
    "total_timeout_seconds": 20
  },
  "timeouts_seconds": [
    {
      "commands": ["preflight"],
      "backend_max": 20,
      "client_min": 35
    },
    {
      "commands": ["setup"],
      "backend_max": 20,
      "client_min": 60
    },
    {
      "commands": ["pair", "tailcat pair"],
      "backend_max": 25,
      "client_min": 45
    },
    {
      "commands": ["runtime", "network", "workspace", "doctor --fix"],
      "backend_max": 30,
      "client_min": 45
    },
    {
      "commands": ["up", "start", "restart"],
      "wait": 60,
      "backend_max": 85,
      "client_min": 110,
      "windows_client": 120
    }
  ],
  "exit_status": {"completed_preflight": 0, "cli_error": 1, "cli_error_stream": "stdout"},
  "wire_codes": [
    {
      "code": "codex_not_found",
      "steps": ["assistant_codex"],
      "platforms": ["macos", "windows", "linux"],
